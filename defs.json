 "traits": {
  "191": {
   "cn": "英雄",
   "en": "Hero",
   "desc": "英雄不惧挑战，会坚守阵地。内心强大。",
   "descEn": "Heroes stand their ground and don't back down from challenges. Mentally strong."
  },
  "655": {
   "cn": "懦弱",
   "en": "Wimp",
   "desc": "不是很勇敢，懦弱的人在与别人发生冲突时经常会选择退缩。",
   "descEn": "Not very brave, a wimp often chooses to flee from a confrontational situation."
  },
  "656": {
   "cn": "笨拙",
   "en": "Clumsy",
   "desc": "笨拙的人易出事故，因为他们做事情粗心，不受约束。",
   "descEn": "A clumsy person often has accidents because they do not behave in a careful, controlled way."
  },
  "1034": {
   "cn": "喜怒无常",
   "en": "Moody",
   "desc": "情绪变化不定，难以预测，尤其容易突然陷入忧郁消沉的状态。",
   "descEn": "A person with unpredictable changes of mood, especially sudden bouts of gloominess or sullenness."
  },
  "1035": {
   "cn": "聪明",
   "en": "Smart",
   "desc": "头脑灵活，擅长解决难题。",
   "descEn": "Intelligent and capable of finding solutions to difficult problems."
  },
  "1036": {
   "cn": "嗜血",
   "en": "Bloodlust",
   "desc": "享受血腥和杀戮。战斗中无所畏惧。",
   "descEn": "Relishes the sight of blood and mayhem. Does not feel unsafe in battles."
  },
  "1037": {
   "cn": "孤僻",
   "en": "Antisocial",
   "desc": "倾向于和人保持距离，喜欢独处。",
   "descEn": "Tends to avoid spending time with other people, and keeps to themselves."
  },
  "1038": {
   "cn": "无安全感",
   "en": "Needy",
   "desc": "需要和别人呆在一起，否则很快就会被孤独击垮。",
   "descEn": "Needs to be around others or will quickly feel overwhelmed by loneliness."
  },
  "1039": {
   "cn": "学习能力强",
   "en": "Fast learner",
   "desc": "学习新事物和新技能的速度比大多数人快。",
   "descEn": "Learns new things and skills faster than most."
  },
  "1040": {
   "cn": "懒惰",
   "en": "Lazy",
   "desc": "不愿意像其他人一样努力。喜欢把更多时间花在休闲娱乐活动上。",
   "descEn": "Not willing to put in as much effort as others. Likes to spend more time on joy and idle activities."
  },
  "1041": {
   "cn": "勤奋",
   "en": "Hard working",
   "desc": "喜欢忙个不停。和其他人相比，对休闲娱乐活动的需求较少。",
   "descEn": "Likes to keep their hands busy most the time. Requires fewer joy and idle activities than others."
  },
  "1042": {
   "cn": "变态",
   "en": "Psychopath",
   "desc": "缺乏同情心或对他人的感情，做任何事情都不会感到难过。",
   "descEn": "Lacks empathy or feeling for other people, and does not feel bad about anything they have done."
  },
  "1043": {
   "cn": "和平爱好者",
   "en": "Peace-loving",
   "desc": "热爱和平，会不遗余力争取和平。相比其他人更容易受冲突影响。",
   "descEn": "Loves peace and tries to promote it in everything they do. Will be more negatively affected by conflicts than others."
  },
  "1044": {
   "cn": "意志坚强",
   "en": "Iron-willed",
   "desc": "不轻言放弃，比大多数人都更有毅力。",
   "descEn": "Will not give up easily and has more mental fortitude than most."
  },
  "1045": {
   "cn": "太空旅行者",
   "en": "Spacefarer",
   "desc": "超爱太空和探险。只要呆在太空中，心情就会一直大好。",
   "descEn": "Absolutely loves space and exploration. Mood is permanently lifted while in space."
  },
  "1046": {
   "cn": "自信",
   "en": "Confident",
   "desc": "自信的人很少优柔寡断，天生自尊心较强，且更擅长社交。",
   "descEn": "A confident person hesitates less, has naturally higher self-esteem and is more adept socially."
  },
  "1047": {
   "cn": "神经质",
   "en": "Neurotic",
   "desc": "经常忧心忡忡，因焦虑和情绪波动而备受煎熬。",
   "descEn": "A constant worrier, plagued by anxiety and mood swings."
  },
  "1048": {
   "cn": "迷人",
   "en": "Charming",
   "desc": "擅长社交，谈判高手。知道如何让他人感到放松。",
   "descEn": "Socially adept and great negotiator. Knows how to make others feel at ease."
  },
  "1533": {
   "cn": "铁胃",
   "en": "Iron stomach",
   "desc": "什么都能吃。馊掉或恶心的食物也不会对其产生影响。",
   "descEn": "This persons stomach can handle anything. Won't be affected by spoiled or disgusting food."
  },
  "1534": {
   "cn": "嗜夜癖",
   "en": "Nyctophilia",
   "desc": "在黑暗中一样感到舒服。没有光线不会影响心情。",
   "descEn": "Finds comfort in the dark. Mood is not affected by the absence of light."
  },
  "1535": {
   "cn": "极简主义者",
   "en": "Minimalist",
   "desc": "这名船员是个禁欲主义者，喜欢万事从简。他不介意睡在地板上，吃饭没有餐桌也没关系。",
   "descEn": "This crew member is an ascetic who likes to keep things simple. They don't mind sleeping on floors or eating without a table."
  },
  "1560": {
   "cn": "话痨",
   "en": "Talkative",
   "desc": "这名船员超爱说话，只要和别人聊上几句情绪就会提升。",
   "descEn": "This crew member loves to talk, and their mood will be boosted whenever they get to have a conversation."
  },
  "1562": {
   "cn": "美食家",
   "en": "Gourmand",
   "desc": "享受美食。每次吃东西心情都会变好。",
   "descEn": "Enjoys eating. Mood is lifted every time this person gets to eat something."
  },
  "2082": {
   "cn": "外星生物爱好者",
   "en": "Alien lover",
   "desc": "外星生物太令我着迷了！我看过所有与它们有关的电影和纪录片。",
   "descEn": "I'm just fascinated with aliens! I have watched all the movies and documentaries of them."
  }
 },
